{
  "name": "congresso-do-chopp",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional do Congresso do Chopp — Bar e Restaurante (Campo Grande, RJ).",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8080 --bind 127.0.0.1",
    "audit": "node audit-congresso.mjs",
    "audit:local": "node audit-congresso.mjs http://127.0.0.1:8080/ --out audit-local",
    "audit:ci": "node audit-congresso.mjs http://127.0.0.1:8080/ --out audit-local --strict",
    "imagens": "node scripts/gerar-imagens.mjs",
    "ilustracoes": "node scripts/gerar-ilustracoes.mjs",
    "preview": "node scripts/gerar-preview.mjs",
    "fotos": "node scripts/aplicar-fotos.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
